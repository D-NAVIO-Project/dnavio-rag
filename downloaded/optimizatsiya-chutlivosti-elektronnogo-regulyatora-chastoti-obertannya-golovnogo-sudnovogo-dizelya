        // ====== ТІЛЬКИ НАЗВА СТОРІНКИ ======
        let pageTitle = '';

        const h1 = document.querySelector('main h1') || document.querySelector('h1');
        if (h1 && h1.textContent.trim()) {
            pageTitle = h1.textContent.trim();
        } else if (document.title) {
            pageTitle = document.title.replace(/\s*\|.*$/, '').trim();
        } else {
            pageTitle = t('siteDefault');
        }

        if (headlineEl) headlineEl.textContent = pageTitle;
        if (tagEl) tagEl.textContent = t('loading');

        // ====== FAKE PROGRESS (плавний) ======
        let p = 0;
        const timer = setInterval(() => {
            if (p < 92) {
                p += (p < 60 ? 6 : 2);
                const v = Math.min(Math.round(p), 92);
                if (barEl) barEl.style.width = v + '%';
                if (countEl) countEl.textContent = v + '%';
            }
        }, 140);

        // ====== HIDE ON LOAD ======
        window.addEventListener('load', () => {
            clearInterval(timer);

            if (barEl) barEl.style.width = '100%';
            if (countEl) countEl.textContent = '100%';

            setTimeout(() => {
                pre.classList.add('is-hidden');
                setTimeout(() => pre.remove(), 700);
            }, 200);
        }, { once: true });
