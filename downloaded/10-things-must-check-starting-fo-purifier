/* 1. Global Reset - Clear out theme padding, lists, and margins */
.sidebar ul,
div[class*="popular-posts"] ul,
ul[class*="popular-posts"] {
    list-style: none !important;
    list-style-type: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* 2. Configure list item rows */
.sidebar ul li,
ul[class*="popular-posts"] li,
div[class*="popular-posts"] li {
    list-style: none !important;
    list-style-type: none !important;
    margin: 0 !important;
    padding: 14px 0 !important; /* Balanced top and bottom spacing */
    border-bottom: 1px solid #eef2f6 !important; /* Soft line divider matching reference */
    display: block !important;
}

/* Strip border separator on the absolute last link item */
.sidebar ul li:last-child,
ul[class*="popular-posts"] li:last-child {
    border-bottom: none !important;
}

/* 3. Force the nested link container into a side-by-side row */
.sidebar ul li a,
ul[class*="popular-posts"] li a {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: flex-start !important; /* CHANGED: Aligns text perfectly to the top edge of the image */
    gap: 16px !important;            /* Space gap separating image and text columns */
    text-decoration: none !important;
    border: none !important;
    box-shadow: none !important;
    width: 100% !important;
}

/* 4. Lock down the thumbnail container size */
.sidebar ul li a img,
ul[class*="popular-posts"] li a img,
.monsterinsights-popular-posts-image {
    flex: 0 0 110px !important;     /* Hard locks column width to 110px */
    width: 110px !important;
    max-width: 110px !important;
    height: 70px !important;        /* Reference framework aspect ratio height */
    max-height: 70px !important;
    border-radius: 6px !important;  /* Modern smooth rounded corners */
    object-fit: cover !important;   /* Prevents shipping images from squishing */
    display: block !important;
    margin: 0 !important;
}

/* 5. Force text node to fill remaining column space and adopt reference styling */
.sidebar ul li a .monsterinsights-popular-posts-text,
.sidebar ul li a .monsterinsights-popular-posts-title,
ul[class*="popular-posts"] li a span:not(.monsterinsights-popular-posts-image),
.monsterinsights-popular-posts-unstyled li a,
.monsterinsights-popular-posts-styled li a {
    flex: 1 1 auto !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    
    /* Precise typography match */
    font-size: 14px !important;    /* Clean 14px font size request */
    font-weight: 700 !important;   /* Solid bold headers */
    line-height: 1.35 !important;
    color: #1e293b !important;     /* Slate charcoal off-black color */
    text-decoration: none !important;
}

/* 6. Deep safety sweep to eliminate any lingering underlines */
.sidebar ul li a, 
.sidebar ul li a *,
ul[class*="popular-posts"] li a * {
    text-decoration: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
}









