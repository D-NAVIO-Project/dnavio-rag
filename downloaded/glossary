.gl-term:hover { border-left-color: #f97316; }
.gl-term-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 6px;
  flex-wrap: wrap;
}
.gl-term-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
}
.gl-term-abbr {
  font-size: 12px;
  font-weight: 600;
  color: #f97316;
  background: #fff7ed;
  border: 0.5px solid #fed7aa;
  padding: 2px 9px;
  border-radius: 4px;
  white-space: nowrap;
}
.gl-term-tags {
  display: flex;
