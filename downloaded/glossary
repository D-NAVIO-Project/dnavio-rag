@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root {
  --navy:   #0a2239;
  --orange: #f97316;
  --border: #e2e8f0;
  --bg:     #f8fafc;
  --txt:    #334155;
  --light:  #94a3b8;
  --radius: 8px;
}

.gl-wrap {
  font-family: 'Inter', sans-serif;
  color: var(--txt);
  font-size: 15px;
  line-height: 1.7;
  max-width: 900px;
  margin: 0 auto;
}

/* ── HERO ── */
.gl-hero {
  background: var(--navy);
  border-radius: 10px;
  padding: 48px 48px 44px;
  margin-bottom: 40px;
}
.gl-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(249,115,22,.15);
  border: 1px solid rgba(249,115,22,.35);
  color: #fed7aa;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 4px 14px;
  border-radius: 20px;
  margin-bottom: 20px;
}
.gl-hero h1 {
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700;
  color: #fff;
  line-height: 1.18;
  letter-spacing: -.02em;
  margin: 0 0 12px;
}
.gl-hero h1 span { color: #f97316; }
.gl-hero-sub {
  font-size: 15px;
  color: #94a3b8;
  max-width: 580px;
  line-height: 1.65;
  margin: 0 0 28px;
}
.gl-stat-row {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,.1);
}
.gl-stat-num {
  font-size: 24px;
  font-weight: 700;
  color: #f97316;
  line-height: 1;
  margin-bottom: 3px;
}
.gl-stat-label {
  font-size: 12px;
  color: #64748b;
  line-height: 1.4;
}

/* ── ALPHA NAV ── */
.gl-alpha-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 36px;
  padding: 16px 20px;
  background: #fff;
  border: 0.5px solid var(--border);
  border-radius: var(--radius);
}
.gl-alpha-nav a {
  font-size: 13px;
  font-weight: 600;
  color: var(--navy) !important;
  text-decoration: none !important;
  padding: 4px 9px;
  border-radius: 5px;
  border: 0.5px solid var(--border);
  background: var(--bg);
  transition: background .12s, border-color .12s;
}
.gl-alpha-nav a:hover {
  background: #f97316;
  color: #fff !important;
  border-color: #f97316;
}
.gl-alpha-nav span {
  font-size: 12px;
  color: var(--light);
  padding: 4px 6px;
  cursor: default;
}

/* ── SEARCH ── */
.gl-search-wrap {
  position: relative;
  margin-bottom: 36px;
}
.gl-search {
  width: 100% !important;
  padding: 13px 16px 13px 44px !important;
  font-size: 14px !important;
  font-family: 'Inter', sans-serif !important;
  border: 1px solid #e2e8f0 !important;
  border-radius: 8px !important;
  background: #ffffff !important;
  color: #334155 !important;
  outline: none !important;
  box-sizing: border-box !important;
  display: block !important;
  appearance: none !important;
  -webkit-appearance: none !important;
  box-shadow: none !important;
}
.gl-search:focus {
  border-color: #f97316 !important;
  box-shadow: 0 0 0 2px rgba(249,115,22,.15) !important;
