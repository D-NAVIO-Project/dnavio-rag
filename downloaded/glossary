<script nonce="5083542faa418e3c9e447eb22c8170da">
function filterGlossary(query) {
  const q = query.toLowerCase().trim();
  const terms = document.querySelectorAll('.gl-term');
  const groups = document.querySelectorAll('.gl-letter-group');
  const alphaNav = document.getElementById('glAlphaNav');
  const noResults = document.getElementById('glNoResults');
  const countEl = document.getElementById('glCount');
  let visible = 0;

  if (!q) {
    terms.forEach(t => t.style.display = '');
    groups.forEach(g => g.style.display = '');
    alphaNav.style.display = 'flex';
    noResults.style.display = 'none';
    countEl.textContent = '';
    return;
  }

  alphaNav.style.display = 'none';

  terms.forEach(t => {
    const text = (t.dataset.terms || '') + ' ' + t.textContent.toLowerCase();
    if (text.includes(q)) {
      t.style.display = '';
      visible++;
    } else {
      t.style.display = 'none';
    }
  });

  groups.forEach(g => {
    const hasVisible = [...g.querySelectorAll('.gl-term')].some(t => t.style.display !== 'none');
    g.style.display = hasVisible ? '' : 'none';
    const anchor = g.querySelector('.gl-letter-anchor');
    if (anchor) anchor.style.display = hasVisible ? '' : 'none';
  });

  countEl.textContent = visible > 0 ? `${visible} term${visible !== 1 ? 's' : ''} found` : '';
  noResults.style.display = visible === 0 ? 'block' : 'none';
}

document.getElementById('glSearch').addEventListener('input', function() {
  filterGlossary(this.value);
});
</script>



